<?xml version="1.0"?>
<?xml-model href="http://www.ros.org"?>
<package format="3">
  <name>ur3_pick_demo</name>
  <version>0.1.0</version>
  <description>Interactive ROS 2 pick demo using a camera-frame target point.</description>
  <maintainer email="chentom@example.com">chentom</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
