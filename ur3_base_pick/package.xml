<?xml version="1.0"?>
<package format="3">
  <name>ur3_base_pick</name>
  <version>0.1.0</version>
  <description>Interactive UR3 position and pick control using base-frame coordinates.</description>
  <maintainer email="chentom@example.com">chentom</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
